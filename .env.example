# Copy to .env for local runs. NEVER put real tokens in this file.
# Tokens may instead be stored in the OS keyring with `adfs-to-okta-setup-tokens`
# (optional; environment variables are used when no keyring is available).

# --- Okta orgs (required, no default; any number of name=URL pairs) ---
OKTA_ENVIRONMENTS=dev=https://your-dev-org.example.com,prod=https://your-prod-org.example.com
# --- Okta API tokens: one OKTA_<NAME>_API_TOKEN per name above (keyring or env) ---
# OKTA_DEV_API_TOKEN=
# OKTA_PROD_API_TOKEN=

# --- Sign-in (web UI) ---
# AUTH_MODE: "oidc" (default) requires the four settings below and the app
# refuses to start without them. "none" runs with no sign-in (local use only).
AUTH_MODE=oidc
# OIDC_ISSUER=https://your-okta-org.example.com/oauth2/default
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# FLASK_SECRET_KEY=         # long random string; shared by every process
# APP_BASE_URL=http://localhost:5001   # default; use https:// when deployed

# Optional allow-lists (comma-separated; default: none = any signed-in user).
# When set, only these emails, or members of these groups (the "groups" claim),
# may sign in.
# ALLOWED_USERS=
# ALLOWED_GROUPS=

# --- Listening address ---
# PORT=5001                 # default 5001 (the container image sets 8080)
# HOST=127.0.0.1            # default; the container image sets 0.0.0.0

# --- Input ---
# ADFS_EXPORT_DIR=          # optional: pre-fill the folder path in the UI

# --- Run log (optional Azure Log Analytics; default is JSON files in logs/) ---
# LA_WORKSPACE_ID=
# LA_WORKSPACE_KEY=
# LA_TABLE_NAME=ADFSImportRuns   # default
# LA_RESOURCE_ID=                # needed to query runs on the /logs page

# --- Optional AI panel (no defaults; all four required to use it) ---
# LLM_BASE_URL=             # OpenAI-compatible server, e.g. http://host:port
# LLM_MODEL_REASON=
# LLM_MODEL_FAST=
# LLM_MODEL_EMBED=
